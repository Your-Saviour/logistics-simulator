# Copy to an untracked, chmod 600 file. Generate independent random secrets.
SHIPPING_USERNAME=operator
SHIPPING_PASSWORD=replace-with-random-operator-secret
SHIPPING_DB_PASSWORD=replace-with-random-database-secret
SHIPPING_BROKER_PASSWORD=replace-with-random-broker-secret
# 32 random bytes, base64 encoded, prefixed base64:
SHIPPING_APP_KEY=base64:replace-with-generated-key
SHIPPING_IDENTITIES=[{"username":"employee","password":"replace-with-independent-employee-secret","role":"employee"}]
SHIPPING_BIND=127.0.0.1
SHIPPING_PORT=8085
SHIPPING_IMAGE=logistics-simulator:shipping-v1
AUTONOMOUS_SHIPPING=true
SHIPPING_STOCK_LOCATION=FINISHED-A
SHIPPING_STOCK_DESTINATION=DISPATCH
SHIPPING_PRODUCTION_LINE=LINE-1
SHIPPING_CARRIER_ROUTE=DISPATCH-CUSTOMER
CLOCK_MODE=standalone
BOUNDARY_PROVIDERS={"orders":"synthetic","goods":"synthetic","carrier":"synthetic"}
SHIPPING_SCENARIO={"seed":1,"time_zone":"Australia/Adelaide","start_at":"2026-01-05T08:00:00+10:30"}
# Omit --profile local and set these for independently placed dependencies.
# SHIPPING_DATABASE_URL=postgresql://shipping:secret@database-host:5432/shipping
# SHIPPING_AMQP_URL=amqp://shipping:secret@broker-host:5672/%2f
