{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simulator:http:warehouse-command:1.0",
  "title": "Storage warehouse command v1",
  "description": "Requires Idempotency-Key header and a current run/epoch. Acceptance schedules durable work; poll warehouse command outcomes.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "epoch",
        "due_at",
        "action",
        "sku",
        "location",
        "quantity",
        "correlation_id"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "epoch": {
          "type": "string",
          "format": "uuid"
        },
        "due_at": {
          "type": "number",
          "minimum": 0
        },
        "action": {
          "const": "expect"
        },
        "sku": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,31}$"
        },
        "location": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]{0,31}$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Strict integer literal; coercions and floating point JSON literals reject."
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
