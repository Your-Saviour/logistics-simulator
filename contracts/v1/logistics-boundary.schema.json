{
  "$defs": {
    "LogisticsFactEnvelope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "type": {
          "enum": [
            "logistics.request.completed.v1",
            "logistics.assign.completed.v1",
            "logistics.load.completed.v1",
            "logistics.depart.completed.v1",
            "logistics.arrive.completed.v1",
            "logistics.unload.completed.v1",
            "logistics.receive.completed.v1"
          ],
          "title": "Type",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "federation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Federation Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "epoch": {
          "format": "uuid",
          "title": "Epoch",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "causation_id": {
          "format": "uuid",
          "title": "Causation Id",
          "type": "string"
        },
        "aggregate_id": {
          "format": "uuid",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_version": {
          "minimum": 1,
          "title": "Aggregate Version",
          "type": "integer"
        },
        "source": {
          "const": "logistics",
          "title": "Source",
          "type": "string"
        },
        "destination": {
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "boundary": {
          "minLength": 1,
          "title": "Boundary",
          "type": "string"
        },
        "effective_time": {
          "minimum": 0,
          "title": "Effective Time",
          "type": "number"
        },
        "wall_time": {
          "format": "date-time",
          "title": "Wall Time",
          "type": "string"
        },
        "quantity_unit": {
          "const": "item",
          "default": "item",
          "title": "Quantity Unit",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TransportRecord"
        }
      },
      "required": [
        "type",
        "federation_id",
        "run_id",
        "epoch",
        "correlation_id",
        "causation_id",
        "aggregate_id",
        "aggregate_version",
        "source",
        "destination",
        "boundary",
        "effective_time",
        "payload"
      ],
      "title": "LogisticsFactEnvelope",
      "type": "object"
    },
    "LogisticsReceiptEnvelope": {
