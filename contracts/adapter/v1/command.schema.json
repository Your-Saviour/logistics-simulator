{
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0",
      "title": "Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "epoch": {
      "format": "uuid",
      "title": "Epoch",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "initialize",
        "poll",
        "receive_ack",
        "request_time",
        "publish",
        "publish_value",
        "checkpoint",
        "finalize"
      ],
      "title": "Operation",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "version",
    "request_id",
    "run_id",
    "epoch",
    "session_id",
    "operation",
    "payload"
  ],
  "title": "Command",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simulator:adapter:command:1.0",
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "initialize"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {},
            "title": "Empty",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "poll"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {},
            "title": "Empty",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "receive_ack"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "event_ids": {
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "maxItems": 10000,
                "title": "Event Ids",
                "type": "array"
              }
            },
            "required": [
              "event_ids"
            ],
            "title": "ReceiveAck",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "request_time"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "target": {
                "minimum": 0,
                "title": "Target",
                "type": "number"
              },
              "committed": {
                "minimum": 0,
                "title": "Committed",
                "type": "number"
              },
              "pending_work": {
                "minimum": 0,
                "title": "Pending Work",
                "type": "integer"
              },
              "pending_outputs": {
                "minimum": 0,
                "title": "Pending Outputs",
                "type": "integer"
              }
            },
            "required": [
              "target",
              "committed",
              "pending_work",
              "pending_outputs"
            ],
            "title": "TimeRequest",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "publish"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "endpoint": {
                "maxLength": 256,
                "minLength": 1,
                "title": "Endpoint",
                "type": "string"
              },
              "envelope": {
                "discriminator": {
                  "mapping": {
                    "logistics.arrive.completed.v1": "#/$defs/LogisticsFactEnvelope",
                    "logistics.assign.completed.v1": "#/$defs/LogisticsFactEnvelope",
                    "logistics.depart.completed.v1": "#/$defs/LogisticsFactEnvelope",
                    "logistics.load.completed.v1": "#/$defs/LogisticsFactEnvelope",
                    "logistics.receipt.v1": "#/$defs/LogisticsReceiptEnvelope",
                    "logistics.receive.completed.v1": "#/$defs/LogisticsFactEnvelope",
                    "logistics.request.completed.v1": "#/$defs/LogisticsFactEnvelope",
                    "logistics.request.v1": "#/$defs/LogisticsRequestEnvelope",
                    "logistics.unload.completed.v1": "#/$defs/LogisticsFactEnvelope",
                    "sample.completed.v1": "#/$defs/Envelope",
                    "storage.arrive.completed.v1": "#/$defs/FactEnvelope",
                    "storage.expect.completed.v1": "#/$defs/FactEnvelope",
                    "storage.issue.completed.v1": "#/$defs/FactEnvelope",
                    "storage.pick.completed.v1": "#/$defs/FactEnvelope",
                    "storage.receipt.v1": "#/$defs/ReceiptEnvelope",
                    "storage.receive.completed.v1": "#/$defs/FactEnvelope",
                    "storage.release.completed.v1": "#/$defs/FactEnvelope",
                    "storage.request.v1": "#/$defs/RequestEnvelope",
                    "storage.reserve.completed.v1": "#/$defs/FactEnvelope",
                    "storage.transfer.arrived.v1": "#/$defs/ArrivalEnvelope",
                    "storage.transfer.completed.v1": "#/$defs/FactEnvelope"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/Envelope"
                  },
                  {
                    "$ref": "#/$defs/ReceiptEnvelope"
                  },
                  {
                    "$ref": "#/$defs/RequestEnvelope"
                  },
                  {
                    "$ref": "#/$defs/ArrivalEnvelope"
                  },
                  {
                    "$ref": "#/$defs/FactEnvelope"
                  },
                  {
                    "$ref": "#/$defs/LogisticsRequestEnvelope"
                  },
                  {
                    "$ref": "#/$defs/LogisticsReceiptEnvelope"
                  },
                  {
                    "$ref": "#/$defs/LogisticsFactEnvelope"
                  }
                ],
                "title": "Envelope"
              }
            },
            "required": [
              "endpoint",
              "envelope"
            ],
            "title": "Publication",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "publish_value"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {
              "value": {
                "title": "Value",
                "type": "number"
              },
              "unit": {
                "const": "item",
                "title": "Unit",
                "type": "string"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "title": "ValuePublication",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "checkpoint"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {},
            "title": "Empty",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "finalize"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "additionalProperties": false,
            "properties": {},
            "title": "Empty",
            "type": "object"
          }
        }
      }
    }
  ],
