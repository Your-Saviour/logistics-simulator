{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simulator:handling:handoff:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "epoch",
    "source",
    "destination_owner",
    "origin",
    "destination",
    "state",
    "unit",
    "departure_token",
    "receipt_id",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "epoch": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "enum": [
        "storage",
        "manufacturing",
        "logistics",
        "shipping"
      ]
    },
    "destination_owner": {
      "enum": [
        "storage",
        "manufacturing",
        "logistics",
        "shipping"
      ]
    },
    "origin": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "destination": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "state": {
      "enum": [
        "offered",
        "accepted",
        "departed",
        "received",
        "acknowledged",
        "quarantined"
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "barcode",
        "run_id",
        "epoch",
        "contents",
        "category",
        "state",
        "owner",
        "custody_generation",
        "last_sequence",
        "position",
        "origin",
        "destination",
        "handoff_id"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "barcode": {
          "type": "string",
          "pattern": "^HU-[0-9A-F]{32}$"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "epoch": {
          "type": "string",
          "format": "uuid"
        },
        "contents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku",
              "quantity"
            ],
            "properties": {
              "sku": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        },
        "category": {
          "enum": [
            "raw",
            "finished"
          ]
        },
        "state": {
          "enum": [
            "available",
            "reserved",
            "in_transit",
            "consumed",
            "dispatched",
            "legacy_unplaced"
          ]
        },
        "owner": {
          "enum": [
            "storage",
            "manufacturing",
            "logistics",
            "shipping"
          ]
        },
        "custody_generation": {
          "type": "integer",
          "minimum": 0
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "available",
                  "reserved"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
              },
              "handoff_id": {
                "type": "null"
              },
              "origin": {
                "type": "null"
              },
              "destination": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "in_transit"
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "null"
              },
              "origin": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
              },
              "destination": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
              },
              "handoff_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "consumed",
                  "dispatched",
                  "legacy_unplaced"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "departure_token": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "handoff_id",
            "unit_id",
            "run_id",
            "epoch",
            "custody_generation",
            "last_sequence",
            "unit_version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "handoff_id": {
              "type": "string",
              "format": "uuid"
            },
            "unit_id": {
              "type": "string",
              "format": "uuid"
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "epoch": {
              "type": "string",
              "format": "uuid"
            },
            "custody_generation": {
              "type": "integer",
              "minimum": 1
            },
            "last_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "unit_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "departed",
              "received",
              "acknowledged"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "departure_token": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "handoff_id",
              "unit_id",
              "run_id",
              "epoch",
              "custody_generation",
              "last_sequence",
              "unit_version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "handoff_id": {
                "type": "string",
                "format": "uuid"
              },
              "unit_id": {
                "type": "string",
                "format": "uuid"
              },
              "run_id": {
                "type": "string",
                "format": "uuid"
              },
              "epoch": {
                "type": "string",
                "format": "uuid"
              },
              "custody_generation": {
                "type": "integer",
                "minimum": 1
              },
              "last_sequence": {
                "type": "integer",
                "minimum": 1
              },
              "unit_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "received",
              "acknowledged"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "receipt_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "quarantined"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
