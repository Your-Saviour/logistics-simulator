# Copy to an untracked file outside the repository; use generated unique secrets.
# URL-special characters in passwords need percent encoding in explicit URLs.
STORAGE_PASSWORD=replace-with-a-generated-secret
STORAGE_USERNAME=operator
STORAGE_IDENTITIES='[{"username":"warehouse","password":"replace-with-another-secret","role":"employee"}]'
STORAGE_BIND=127.0.0.1
STORAGE_PORT=8082
AUTONOMOUS_WAREHOUSE=true
# For CyberLab placement, set reachable department-owned dependency addresses:
# STORAGE_DATABASE_URL=postgresql://storage:encoded-secret@storage-db.internal:5432/storage
# STORAGE_AMQP_URL=amqp://storage:encoded-secret@storage-broker.internal:5672/%2f
# STORAGE_API_UPSTREAM=storage-api.internal:8000
# STORAGE_SCENARIO={"seed":7,"warehouse":{"locations":[{"code":"RAW-A","capacity":500},{"code":"FINISHED-A","capacity":500},{"code":"DISPATCH","capacity":250}],"catalog":[{"sku":"COMPONENT","kind":"raw"},{"sku":"PRODUCT","kind":"finished"}]}}
