# Copy outside the repository and replace secrets. URL-encode explicit connection URLs.
MANUFACTURING_PASSWORD=replace-with-a-generated-secret
MANUFACTURING_USERNAME=operator
MANUFACTURING_IDENTITIES='[{"username":"production","password":"replace-with-another-secret","role":"employee"}]'
MANUFACTURING_BIND=127.0.0.1
MANUFACTURING_PORT=8083
AUTONOMOUS_PRODUCTION=true
# External CyberLab placement: omit the local profile and provide reachable addresses.
# MANUFACTURING_DATABASE_URL=postgresql://manufacturing:encoded-secret@factory-db.internal:5432/manufacturing
# MANUFACTURING_AMQP_URL=amqp://manufacturing:encoded-secret@factory-broker.internal:5672/%2f
# MANUFACTURING_API_UPSTREAM=factory-api.internal:8000
# MANUFACTURING_SCENARIO={"seed":7,"interval_seconds":30}
# Optional recurring pump-assembly catalog/BOM/finite-line preset:
# SCENARIO_PRESET=pump-assembly
