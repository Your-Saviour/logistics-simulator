# Copy to an ignored private file and replace every placeholder before starting.
MANUFACTURING_USERNAME=operator
MANUFACTURING_PASSWORD=replace-with-random-secret
# JSON must be on one line; use the same HMI password as FUXA_API_PASSWORD.
MANUFACTURING_IDENTITIES=[{"username":"employee","password":"replace-with-employee-secret","role":"employee"},{"username":"fuxa","password":"replace-with-hmi-secret","role":"operator","scopes":["status:read","runs:control"]}]
FUXA_API_USERNAME=fuxa
FUXA_API_PASSWORD=replace-with-hmi-secret
PLC_USERNAME=ot-admin
PLC_PASSWORD=replace-with-plc-secret
OT_EQUIPMENT_TOKEN=replace-with-random-token-at-least-16-characters
SCENARIO_PRESET=pump-assembly
AUTONOMOUS_PRODUCTION=false
MANUFACTURING_BIND=127.0.0.1
MANUFACTURING_PORT=8083
FUXA_BIND=127.0.0.1
FUXA_PORT=1881
