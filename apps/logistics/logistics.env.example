# Copy outside source control. Replace every example secret before deployment.
LOGISTICS_DATABASE_URL=postgresql://logistics:replace-db-password@logistics-db:5432/logistics
LOGISTICS_AMQP_URL=amqp://logistics:replace-broker-password@logistics-broker:5672/%2f
LOGISTICS_DB_PASSWORD=replace-db-password
LOGISTICS_BROKER_PASSWORD=replace-broker-password
LOGISTICS_USERNAME=operator
LOGISTICS_PASSWORD=replace-operator-password
LOGISTICS_IDENTITIES=[{"username":"employee","password":"replace-employee-password","role":"employee"}]
LOGISTICS_API_UPSTREAM=logistics-api:8000
LOGISTICS_BIND=127.0.0.1
LOGISTICS_PORT=8084
CLOCK_MODE=standalone
BOUNDARY_PROVIDERS={"transport":"synthetic","destinations":"synthetic"}
AUTONOMOUS_SAMPLE=true
