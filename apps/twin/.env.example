# Copy to untracked apps/twin/.env and fill all three secrets.
# Use distinct random URL-safe values for database/broker passwords, e.g. hex.
TWIN_DATABASE_PASSWORD=
TWIN_BROKER_PASSWORD=
TWIN_PASSWORD=
TWIN_USERNAME=twin-operator
TWIN_PORT=8086
# JSON values must remain server-side. Single quoting avoids dotenv interpolation.
TWIN_IDENTITIES='[]'
TWIN_SOURCES='[]'
TWIN_CONTROL_TARGETS='[]'
